@@ -274,6 +278,30 @@ HorizontalTabStripRegionView::HorizontalTabStripRegionView(
     tab_strip_action_container_ =
         AddChildView(std::move(tab_strip_action_container));
   }
+
+  // Sponari: the profile avatar belongs at the trailing edge of the tab strip
+  // row, not in the toolbar. Added last so FlexLayout — which orders the main
+  // axis by child index — places it past `reserved_grab_handle_space_`. It
+  // deliberately gets no kFlexBehaviorKey: the default spec pins it to its
+  // preferred width, while the grab handle's unbounded flex sits at order 3 and
+  // so is only allocated whatever is left over.
+  if (browser &&
+      browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+      !features::IsWebUIAvatarButtonEnabled()) {
+    avatar_button_ =
+        AddChildView(std::make_unique<AvatarToolbarButton>(browser_view));
+    avatar_button_->SetVisible(
+        AvatarToolbarButtonInterface::CanShowForProfile(browser->GetProfile()));
+    avatar_button_->SetProperty(views::kCrossAxisAlignmentKey,
+                                views::LayoutAlignment::kCenter);
+    avatar_button_->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(
+            0, 0, 0, GetLayoutConstant(LayoutConstant::kTabStripPadding)));
+    // Without this the tab strip row treats the click as a window drag.
+    views::SetHitTestComponent(avatar_button_, static_cast<int>(HTCLIENT));
+  }
+
   UpdateTabStripMargin();
 }
