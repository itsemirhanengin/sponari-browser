+AvatarToolbarButton* ToolbarView::avatar_toolbar_button() {
+  // Sponari: the button lives in the tab strip region. Falls back to `avatar_`
+  // (always null today) so this stays correct if the toolbar ever owns one
+  // again — e.g. if vertical tabs hide the horizontal region view.
+  auto* const region = browser_view_->horizontal_tab_strip_region_view();
+  return region && region->avatar_button() ? region->avatar_button()
+                                           : avatar_.get();
 }
 
