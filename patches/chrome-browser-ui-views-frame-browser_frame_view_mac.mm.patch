+SkPath BrowserFrameViewMac::GetTopChromeSilhouette(float scale) {
+  // Sponari: the toolbar and the active tab are one continuous light sheet
+  // sitting on the glass, so they have to cast ONE shadow. Two shadows — one
+  // per view — compound where their blurs overlap at the tab's base, and that
+  // darker seam is exactly what stops the two edges reading as the same object.
+  views::View* const toolbar = GetBrowserView()->toolbar();
+  if (!toolbar || !toolbar->GetVisible()) {
+    return SkPath();
+  }
+
+  gfx::Point toolbar_origin;
+  views::View::ConvertPointToTarget(toolbar, this, &toolbar_origin);
+  // Extended well past the bottom of the window: only the top edge casts a
+  // shadow we want, and this keeps the bottom corners out of the picture.
+  const SkRect toolbar_rect =
+      SkRect::MakeXYWH(toolbar_origin.x() * scale, toolbar_origin.y() * scale,
+                       toolbar->width() * scale,
+                       (height() - toolbar_origin.y() + 64) * scale);
+  const SkScalar radius =
+      GetLayoutConstant(LayoutConstant::kToolbarCornerRadius) * scale;
+  SkRRect toolbar_rrect;
+  toolbar_rrect.setRectXY(toolbar_rect, radius, radius);
+
+  // SkPath is immutable in this Skia; shapes are assembled through
+  // SkPathBuilder and transformed with the make* helpers.
+  SkPath silhouette = SkPathBuilder().addRRect(toolbar_rrect).detach();
+
+  // Union in the active tab, so the shadow runs from its rounded shoulder along
+  // the toolbar's top edge without a seam.
+  HorizontalTabStripRegionView* const region =
+      GetBrowserView()->horizontal_tab_strip_region_view();
+  TabStrip* const tab_strip = region ? region->tab_strip() : nullptr;
+  if (!tab_strip || !tab_strip->GetVisible()) {
+    return silhouette;
+  }
+  const std::optional<int> active_index = tab_strip->GetActiveIndex();
+  if (!active_index.has_value()) {
+    return silhouette;
+  }
+  Tab* const active_tab = tab_strip->tab_at(active_index.value());
+  if (!active_tab || !active_tab->GetVisible()) {
+    return silhouette;
+  }
+
+  gfx::Point tab_origin;
+  views::View::ConvertPointToTarget(active_tab, this, &tab_origin);
+  const SkPath tab_path =
+      active_tab->tab_style_views()
+          ->GetPath(TabStyle::PathType::kActiveTab, scale, {})
+          .makeOffset(tab_origin.x() * scale, tab_origin.y() * scale);
+
+  // SkPathOps rather than adding both to one path: a plain add would rely on
+  // the two shapes being wound the same way, and an opposite winding would
+  // punch a hole through the overlap.
+  SkPath united;
+  if (Op(silhouette, tab_path, kUnion_SkPathOp, &united)) {
+    return united;
+  }
+  return silhouette;
+}
+
+void BrowserFrameViewMac::PaintTopChromeShadow(gfx::Canvas* canvas) {
+  // Painted from the frame view because a view's own painting is clipped to its
+  // bounds, and this shadow has to fall *above* the toolbar, in the tab strip
+  // row. The frame paints before its children, so the sheet itself covers the
+  // interior and only the cast shadow remains visible.
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const float scale = canvas->UndoDeviceScaleFactor();
+
+  const SkPath silhouette = GetTopChromeSilhouette(scale);
+  if (silhouette.isEmpty()) {
+    return;
+  }
+
+  // Tuned in chrome_color_provider_utils.h, next to the other top chrome dials.
+  std::vector<gfx::ShadowValue> shadows;
+  shadows.emplace_back(
+      gfx::Vector2d(0, 1), kSponariTopChromeShadowContactBlur,
+      SkColorSetA(SK_ColorBLACK, kSponariTopChromeShadowContactAlpha));
+  shadows.emplace_back(
+      gfx::Vector2d(0, 0), kSponariTopChromeShadowAmbientBlur,
+      SkColorSetA(SK_ColorBLACK, kSponariTopChromeShadowAmbientAlpha));
+
+  // Clip the sheet away so only the shadow it casts survives. Without this the
+  // opaque fill would sit behind the translucent toolbar and cancel the glass.
+  canvas->sk_canvas()->clipPath(silhouette, SkClipOp::kDifference,
+                                /*doAntiAlias=*/true);
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(SK_ColorBLACK);
+  flags.setLooper(gfx::CreateShadowDrawLooper(shadows));
+  canvas->sk_canvas()->drawPath(silhouette, flags);
+}
