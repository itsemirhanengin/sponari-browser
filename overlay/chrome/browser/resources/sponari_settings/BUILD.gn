import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "sponari_settings"

  static_files = [ "sponari_settings.html" ]

  ts_files = [
    "about_page.html.ts",
    "about_page.ts",
    "app.html.ts",
    "app.ts",
    "general_page.html.ts",
    "general_page.ts",
    "privacy_page.html.ts",
    "privacy_page.ts",
  ]

  css_files = [
    "app.css",
    "settings_shared.css",
  ]

  icons_html_files = [ "icons.html" ]

  ts_composite = true
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
  ]

  webui_context_type = "trusted"
}
